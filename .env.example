# Postgres (used by the db service and to build DATABASE_URL for the api)
POSTGRES_USER=postgres
# Use URL-safe characters (e.g. openssl rand -hex 24): it is embedded in DATABASE_URL
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me
ADMIN_PWD=admin-password

# Browser origin allowed by CORS / Socket.IO
FRONTEND_URL=https://scorpio.cpsrtc.cl

# 'public' = anyone can sign up (always as normal user); 'admin' = only admins create users
SIGNUP_MODE=admin

# Proxy hops in front of the API (CloudFront -> ELB = 2; add 1 if nginx proxies in between)
TRUST_PROXY_HOPS=3

# Run prisma/seed (creates the admin user if missing) on container start
SEED_ON_START=true
