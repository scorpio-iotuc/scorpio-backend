// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  NORMAL @map("normal")
  ADMIN  @map("admin")
}

enum SatelliteUpsertJobStatus {
  queued
  running
  completed
  failed
}

model SatelliteUpsertJob {
  id            String                  @id @default(uuid())
  status        SatelliteUpsertJobStatus @default(queued)
  started_at    DateTime                 @default(now())
  finished_at   DateTime?
  downloaded    Boolean                 @default(false)
  created       DateTime                 @default(now())
  updated       DateTime                 @updatedAt
  schedule_key  String?                 @unique
  error_message String?

  @@index([created])
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  pwd_encrypted String
  type          UserType @default(NORMAL)

  stations Station[] @relation("OwnedStations")
}

model Satellite {
  id                Int       @id @default(autoincrement())
  norad_id          Int       @unique
  display_name      String
  object_id         String?
  epoch             DateTime?
  mean_motion       Float?
  eccentricity      Float?
  inclination       Float?
  ra_of_asc_node    Float?
  arg_of_pericenter Float?
  mean_anomaly      Float?
  bstar             Float?
  mean_motion_dot   Float?
  mean_motion_ddot  Float?
  tle1              String?
  tle2              String?
  tle_updated_at    DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  packets Packet[] @relation("SatellitePackets")
  passes SatellitePass[]
}

model Station {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique
  name           String
  latitude       Float
  longitude      Float
  altitude       Float
  status         Boolean  @default(false)
  creation_date  DateTime @default(now())
  last_seen      DateTime @default(now())
  decoder_config Bytes?
  owner_id       Int
  owner_key_hash String

  owner   User     @relation("OwnedStations", fields: [owner_id], references: [id])
  packets Packet[] @relation("StationPackets")
  passGenerations StationPassGeneration[]
  passes SatellitePass[]
}

model Packet {
  id                  Int      @id @default(autoincrement())
  station_id          Int
  satellite_id        Int
  satellite_latitude  Float
  satellite_longitude Float
  satellite_altitude  Float
  slant_distance      Float
  angle_elevation     Float
  rssi                Float
  snr                 Float
  frec_error          Float
  crc                 Boolean
  raw_payload         Bytes
  created_at          DateTime @default(now())

  station   Station   @relation("StationPackets", fields: [station_id], references: [id])
  satellite Satellite @relation("SatellitePackets", fields: [satellite_id], references: [id])
}

// One generation is published only when every station and satellite batch finishes.
model StationPassJob {
  id             String                  @id @default(uuid())
  status         SatelliteUpsertJobStatus @default(queued)
  schedule_key   String?                 @unique
  window_hours   Int                     @default(72)
  window_start   DateTime?
  window_end     DateTime?
  started_at     DateTime?
  finished_at    DateTime?
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  error_message  String?
  generated      Int                     @default(0)
  skipped        Int                     @default(0)
  generations    StationPassGeneration[]

  @@index([status, created_at])
}

// Also records successful station predictions with zero qualifying passes.
model StationPassGeneration {
  id           String         @id @default(uuid())
  job_id       String
  station_uuid String
  latitude     Float
  longitude    Float
  altitude     Float
  created_at   DateTime       @default(now())
  job          StationPassJob @relation(fields: [job_id], references: [id], onDelete: Cascade)
  station      Station        @relation(fields: [station_uuid], references: [uuid], onDelete: Cascade)
  passes       SatellitePass[]

  @@unique([job_id, station_uuid])
  @@unique([id, station_uuid])
  @@index([station_uuid, created_at])
}

model SatellitePass {
  id               String                @id @default(uuid())
  generation_id    String
  station_uuid     String
  satellite_id     Int
  satellite_name   String
  satellite_norad_id Int
  aos              DateTime
  los              DateTime
  max_elevation    Float
  max_elevation_at DateTime
  orbital_snapshot Json
  created_at       DateTime              @default(now())
  generation       StationPassGeneration @relation(fields: [generation_id, station_uuid], references: [id, station_uuid], onDelete: Cascade)
  station          Station               @relation(fields: [station_uuid], references: [uuid], onDelete: Cascade)
  satellite        Satellite             @relation(fields: [satellite_id], references: [id], onDelete: Cascade)

  @@unique([generation_id, satellite_id, aos])
  @@index([generation_id, station_uuid, aos])
  @@index([satellite_id])
  @@index([los])
}
